<view class="nav-wrap">
  <view class="bottom-nav">
    <view
      wx:for="{{items}}"
      wx:key="label"
      class="nav-item {{index === current ? 'active' : ''}} {{item.center ? 'center-item' : ''}}"
      data-index="{{index}}"
      bindtap="navigate"
    >
      <view class="nav-icon">
        <image wx:if="{{item.center}}" class="center-art" src="{{item.art}}" mode="aspectFit"></image>
        <app-icon wx:else name="{{index === current && item.activeIcon ? item.activeIcon : item.icon}}" size="{{23}}"></app-icon>
      </view>
      <text wx:if="{{!item.center}}">{{item.label}}</text>
    </view>
  </view>
</view>
