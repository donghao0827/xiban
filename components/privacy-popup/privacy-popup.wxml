<view wx:if="{{visible}}" class="privacy-mask" catchtouchmove="stop" bindtap="stop">
  <view class="privacy-dialog" catchtap="stop">
    <view class="privacy-symbol"><app-icon name="profile-cloud" size="{{30}}"></app-icon></view>
    <view class="privacy-title">隐私保护提示</view>
    <view class="privacy-copy">
      为使用头像或图片选择功能，需要你阅读并同意
      <text bindtap="openPrivacyContract">《用户隐私保护指引》</text>。
      我们只处理你主动选择的图片。
    </view>
    <view class="privacy-actions">
      <button class="privacy-cancel" bindtap="disagree">暂不同意</button>
      <button
        id="privacy-agree-button"
        class="privacy-agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="agree"
      >同意并继续</button>
    </view>
  </view>
</view>
